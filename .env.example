# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of THIS service (used for OIDC redirect URIs and cookie scope)
APP_BASE_URL=http://localhost:3000
# Port the NestJS server listens on
PORT=3000
# Secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in seconds (default 8h)
SESSION_TTL_SECONDS=28800
# Session cookie Secure flag: auto = secure when APP_BASE_URL is https
SESSION_COOKIE_SECURE=auto
NODE_ENV=development

# ── Redis (server-side session store) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Keycloak / OIDC SSO (optional — leave blank to use Bearer/API Key/Basic/OAuth2 in UI) ──
# KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/getapp
# KEYCLOAK_CLIENT_ID=dashboard-gpt
# KEYCLOAK_CLIENT_SECRET=dev-secret
KEYCLOAK_SCOPE=openid profile email
# Set only when the issuer URL is not reachable from this service (e.g. issuer is
# localhost:8080 but the app runs in docker and reaches it as keycloak:8080).
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ── Target API ───────────────────────────────────────────────────────────────
# Base URL of the target API (the service appends endpoint paths)
API_BASE_URL=https://fakerestapi.azurewebsites.net
# Per-tool-call HTTP timeout in ms
API_TIMEOUT_MS=15000
# Optional path to local OpenAPI/Swagger spec file (.yaml or .json)
# OPENAPI_SPEC_PATH=./openapi/getapp-api.yaml
# Optional remote URL to OpenAPI/Swagger spec (if neither is set, probes API_BASE_URL)
OPENAPI_SPEC_URL=https://fakerestapi.azurewebsites.net/swagger/v1/swagger.json
# Local directory where the startup agent saves generated tools & slash menu
TOOLS_DATA_DIR=./generated
# Run the startup discovery agent when TOOLS_DATA_DIR has no existing config
STARTUP_AGENT_ENABLED=true
FORCE_REGENERATE_TOOLS=false
STARTUP_AGENT_MIN_ENDPOINTS=15
STARTUP_AGENT_MAX_ENDPOINTS=25
# Optional default auth settings for the Connect UI
API_KEY_HEADER=X-API-Key
# API_LOGIN_PATH=/api/v1/login
# OAUTH2_TOKEN_URL=https://auth.example.com/oauth/token
# DASHBOARD_BASE_URL=https://dashboard.example.com

# ── LLM provider (any OpenAI-compatible endpoint) ────────────────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Max LLM <-> tool round trips per chat request
MAX_TOOL_STEPS=8
# Tool results are truncated to this many characters before going to the model
MAX_TOOL_RESULT_CHARS=8000
# Chat requests per user per minute
CHAT_RATE_LIMIT_PER_MINUTE=20
# Overall timeout for one /api/chat request in ms
CHAT_REQUEST_TIMEOUT_MS=120000

# ── Optional: Keycloak token exchange (default off) ──────────────────────────
# Exchange the user's token for a narrower short-lived agent token
ENABLE_TOKEN_EXCHANGE=false
TOKEN_EXCHANGE_AUDIENCE=
# Optional: path to a file that overrides the built-in agent system prompt
# SYSTEM_PROMPT_FILE=/etc/dashboard-gpt/system-prompt.txt
